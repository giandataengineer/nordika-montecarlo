# Copia este archivo como .env y pon tus claves.
# Las tres son gratuitas y no piden tarjeta:
#   Groq       -> console.groq.com/keys
#   OpenRouter -> openrouter.ai/keys
#   Gemini     -> aistudio.google.com/apikey
#   Cerebras   -> cloud.cerebras.ai (su free tier pide facturación activada)
#
# El proyecto FUNCIONA SIN NINGUNA CLAVE: sin ellas el informe usa el camino
# determinista con guardarrail de coherencia. Las claves solo activan las tres
# lecturas con modelos independientes.

# Un proveedor por rol: si dos roles comparten proveedor se agota su límite
# por minuto y los dos caen a la vez.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Refuerzos opcionales de la cadena. Cada clave que aparezca aqui suma sus
# modelos a la rueda de reintentos; las que falten se saltan sin romper nada.
#   Z.ai (GLM)   -> z.ai/model-api
#   DashScope    -> bailian.console.alibabacloud.com  (Qwen, endpoint intl)
#   MiniMax      -> platform.minimax.io
#   NVIDIA NIM   -> build.nvidia.com  (DeepSeek y Nemotron alojados)
#   Moonshot     -> platform.moonshot.ai  (Kimi)
#   Mistral      -> console.mistral.ai  (tier Experiment, el mas generoso)
#   GitHub       -> github.com/settings/tokens  (un PAT basta, sin permisos)
#   SambaNova    -> cloud.sambanova.ai
#   HuggingFace  -> huggingface.co/settings/tokens
#   Scaleway     -> console.scaleway.com  (Generative APIs)
ZAI_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
SAMBANOVA_API_KEY=
HF_TOKEN=
SCALEWAY_API_KEY=

# Opcionales: sobrescriben el modelo por defecto de cada proveedor
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GEMINI_MODEL=gemini-3.6-flash
# Alternativa con mas cuota diaria y mas rapida, algo menos capaz:
# GEMINI_MODEL=gemini-flash-lite-latest
